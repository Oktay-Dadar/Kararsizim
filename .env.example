# Yerel geliştirme içindir. Production (Vercel) değişkenleri için: docs/DEPLOY.md

# Django
DJANGO_SECRET_KEY=degistir-bunu
DJANGO_DEBUG=True
# Vercel'de gerekmez: settings, VERCEL_URL vb. adresleri kendisi ekler.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Yalnızca yerelde DJANGO_DEBUG=False denerken https yönlendirmesini kapatmak için:
# DJANGO_SECURE_SSL_REDIRECT=False

# Anonim oy anahtarı tuzu — production'da mutlaka farklı olsun
VOTER_KEY_SALT=degistir-bunu-da

# Boş bırakılırsa yerelde SQLite kullanılır.
# Supabase — uygulama çalışırken (Transaction pooler, port 6543)
DATABASE_URL=
# Host'u Supabase panelindeki Connect penceresinden kopyala (bu projede aws-1-eu-central-1).
# DATABASE_URL=postgresql://postgres.<PROJE_REF>:<PAROLA>@aws-1-<BOLGE>.pooler.supabase.com:6543/postgres

# Supabase — sadece migration için (Session pooler, port 5432)
# Kullanım: $env:DJANGO_DB_DIRECT=1; .venv\Scripts\python manage.py migrate
DATABASE_URL_DIRECT=
# DATABASE_URL_DIRECT=postgresql://postgres.<PROJE_REF>:<PAROLA>@aws-1-<BOLGE>.pooler.supabase.com:5432/postgres
